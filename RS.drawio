        </mxCell>
        <mxCell id="EOgTCbZ0sA1uzU6uYuZY-62" edge="1" parent="1" source="EOgTCbZ0sA1uzU6uYuZY-8" style="endArrow=none;html=1;rounded=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;fontFamily=Garamond;" target="EOgTCbZ0sA1uzU6uYuZY-56" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="960" y="313.25" as="sourcePoint" />
            <mxPoint x="939" y="515.25" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <UserObject label="Graph-based RS" tooltip="Graph-based RS biểu diễn hệ gợi ý dưới dạng đồ thị, trong đó node thường là user hoặc item, còn edge là các tương tác hay quan hệ giữa chúng. Mô hình học bằng cách truyền và tổng hợp thông tin từ các node lân cận qua nhiều lớp message passing, nhờ đó khai thác được quan hệ bậc cao và cấu trúc kết nối phức tạp trong dữ liệu; thách thức chính là độ phức tạp tính toán, nguy cơ oversmoothing khi truyền quá nhiều lớp, cùng yêu cầu về độ tin cậy, công bằng và khả năng giải thích" id="EOgTCbZ0sA1uzU6uYuZY-64">
          <mxCell parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Garamond;" vertex="1">
            <mxGeometry height="26" width="108" x="951" y="546.25" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Sequential &amp;amp; Session-based RS&amp;nbsp;" tooltip="Sequential RS xem lịch sử tương tác của user như một chuỗi theo thời gian để dự đoán hành động kế tiếp hoặc sở thích tương lai, còn Session-based RS tập trung vào tín hiệu ngắn hạn trong phiên hiện tại để gợi ý theo thời gian thực. Các mô hình này thường dùng RNN, self-attention, Transformer hoặc GNN để học phụ thuộc ngắn hạn và dài hạn trong chuỗi hành vi; thách thức chính là dữ liệu hành vi thay đổi nhanh, độ dài chuỗi lớn làm tăng chi phí tính toán, và việc cân bằng giữa sở thích ngắn hạn của phiên hiện tại với sở thích dài hạn của user." id="EOgTCbZ0sA1uzU6uYuZY-65">
          <mxCell parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Garamond;" vertex="1">
            <mxGeometry height="26" width="192" x="951" y="685.25" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Knowledge-based RS" tooltip="Hệ gợi ý này dùng tri thức ngoài dữ liệu tương tác, thường là knowledge graph hoặc knowledge base, để hiểu sâu hơn về item và mối quan hệ giữa các thực thể. Ví dụ, nếu một bộ phim nối với đạo diễn, thể loại và diễn viên trong knowledge graph, hệ thống có thể gợi ý phim tương tự ngay cả khi dữ liệu click hay rating còn ít. Cách làm phổ biến gồm học embedding cho entity và relation, khai thác đường đi trong graph, hoặc lan truyền thông tin nhiều bước qua các quan hệ tri thức; thách thức chính là xây dựng tri thức đủ tốt, giữ được ý nghĩa của quan hệ, và tránh mô hình quá phức tạp khi đồ thị lớn." id="EOgTCbZ0sA1uzU6uYuZY-67">
          <mxCell parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Garamond;" vertex="1">
            <mxGeometry height="26" width="134" x="951" y="593.25" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Reinforment learning-based RS" tooltip="RL-based RS xem hệ gợi ý như một agent liên tục chọn action, tức là chọn item hay danh sách item để đề xuất, rồi nhận reward từ phản hồi của user như click, dwell time hay purchase. Thay vì chỉ tối ưu một dự đoán tĩnh, mô hình học chính sách để cân bằng giữa lợi ích ngắn hạn và dài hạn, thách thức lớn là thiết kế reward hợp lý, xử lý trade-off giữa exploration và exploitation, độ bất ổn khi huấn luyện và khó đánh giá chính xác khi môi trường user luôn thay đổi" id="EOgTCbZ0sA1uzU6uYuZY-68">
          <mxCell parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Garamond;" vertex="1">
            <mxGeometry height="26" width="186" x="951" y="500.25" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="LLM-based RS" tooltip="LLM-based RS đưa các mô hình ngôn ngữ lớn vào bài toán gợi ý để khai thác hiểu biết ngữ nghĩa, khả năng xử lý ngôn ngữ tự nhiên và thích nghi theo prompt hoặc in-context learning. Chúng có thể dùng để biểu diễn user/item từ văn bản, hỗ trợ conversational recommendation, re-ranking hoặc zero-shot recommendation; tuy nhiên, các mô hình này đòi hỏi tài nguyên lớn, bị ràng buộc bởi context window, có thể khuếch đại popularity bias hoặc vấn đề đạo đức, và thường khó kiểm soát tính ổn định khi sinh đầu ra." id="EOgTCbZ0sA1uzU6uYuZY-69">
          <mxCell parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Garamond;" vertex="1">
            <mxGeometry height="26" width="98" x="951" y="454.25" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Multimodal RS" tooltip="Multimodal RS kết hợp nhiều loại dữ liệu như văn bản, hình ảnh, âm thanh, video hoặc metadata để mô tả user và item đầy đủ hơn. Mô hình thường có các encoder riêng cho từng modality rồi hợp nhất chúng bằng cơ chế fusion, attention hoặc contrastive learning để tạo representation chung; thách thức nằm ở việc các modality có chất lượng không đồng đều, khó căn chỉnh ngữ nghĩa giữa các nguồn dữ liệu, tốn tài nguyên tính toán và dễ bị phụ thuộc quá mức vào modality mạnh hơn." id="EOgTCbZ0sA1uzU6uYuZY-70">
          <mxCell parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Garamond;" vertex="1">
            <mxGeometry height="26" width="96" x="951" y="639.25" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="EOgTCbZ0sA1uzU6uYuZY-72" edge="1" parent="1" source="EOgTCbZ0sA1uzU6uYuZY-9" style="endArrow=none;html=1;rounded=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;fontFamily=Garamond;" target="EOgTCbZ0sA1uzU6uYuZY-69" value="">
