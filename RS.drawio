        <UserObject label="Collaborative Filtering&lt;br&gt;(CF)" tooltip="Phương pháp này học từ lịch sử tương tác user-item để dự đoán user sẽ thích gì tiếp theo. Điểm yếu chính là dữ liệu thưa, khó với user/item mới và chi phí mở rộng lớn" id="EOgTCbZ0sA1uzU6uYuZY-5">
          <mxCell parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Garamond;" vertex="1">
            <mxGeometry height="37" width="133" x="951" y="109" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Content-based Filtering (CBF)" tooltip="Phương pháp gợi ý dựa trên đặc trưng của item và sở thích của user. Hệ thống đề xuất các item có nội dung tương tự với những gì user đã thích trước đó" id="EOgTCbZ0sA1uzU6uYuZY-6">
          <mxCell parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Garamond;" vertex="1">
            <mxGeometry height="34" width="103" x="951" y="-17" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Hybrid RS" tooltip="Hệ thống gợi ý kết hợp nhiều phương pháp, thường là Collaborative Filtering và Content-based Filtering, để bù điểm yếu cho nhau. Ví dụ: một app phim có thể vừa xem bạn đã thích thể loại nào, vừa xem những người giống bạn đang xem gì." id="EOgTCbZ0sA1uzU6uYuZY-7">
          <mxCell parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Garamond;" vertex="1">
            <mxGeometry height="26" width="72" x="975" y="55" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Deep learning" tooltip="Nhóm mô hình dùng mạng nơ-ron để học các quan hệ ẩn trong dữ liệu. So với các cách truyền thống, deep learning thường bắt được nhiều kiểu quan hệ hơn giữa user và item, nên phù hợp khi dữ liệu lớn và tương tác khá phức tạp" id="EOgTCbZ0sA1uzU6uYuZY-8">
          <mxCell parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Garamond;" vertex="1">
            <mxGeometry height="26" width="93" x="792" y="305.25" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Advanced" tooltip="Nhóm các mô hình gợi ý tiên tiến, kết hợp những kỹ thuật mới nhất của AI để giải quyết các bài toán khó mà phương pháp truyền thống hay deep learning cơ bản chưa làm tốt. " id="EOgTCbZ0sA1uzU6uYuZY-9">
          <mxCell parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Garamond;" vertex="1">
            <mxGeometry height="26" width="71" x="808" y="565" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Specialized" tooltip="Specialized Recommender Systems là nhóm hệ gợi ý được thiết kế cho những nhu cầu rất cụ thể, nơi dữ liệu hoặc mục tiêu không còn chỉ là user-item interaction thông thường mà còn bao gồm context, review, aspect, tính giải thích, độ tin cậy và fairness." id="EOgTCbZ0sA1uzU6uYuZY-10">
