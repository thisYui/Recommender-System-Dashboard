        <UserObject label="Multi-Layer Perceptrons" tooltip="Mạng nơ-ron nhiều lớp, thường dùng để học quan hệ phi tuyến giữa user và item. Ví dụ, thay vì chỉ cộng trừ điểm giống nhau, MLP cố học sâu hơn kiểu “user này thường thích loại item nào trong những ngữ cảnh khác nhau”." id="EOgTCbZ0sA1uzU6uYuZY-43">
          <mxCell parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Garamond;" vertex="1">
            <mxGeometry height="26" width="144" x="951" y="201.25" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Autoencoders" tooltip="Mô hình học cách nén rồi khôi phục dữ liệu, nhờ đó rút ra biểu diễn ngắn gọn nhưng vẫn giữ được thông tin quan trọng. Giúp xử lý dữ liệu thưa và học được các tương tác ẩn." id="EOgTCbZ0sA1uzU6uYuZY-48">
          <mxCell parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Garamond;" vertex="1">
            <mxGeometry height="26" width="92" x="951" y="283.25" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="CNN" tooltip="Thường dùng để bắt các mẫu cục bộ trong dữ liệu, như đoạn văn, hình ảnh, hoặc chuỗi hành vi ngắn. Trong gợi ý, CNN hữu ích khi muốn học đặc trưng từ nội dung item hoặc từ các pattern gần nhau trong chuỗi tương tác." id="EOgTCbZ0sA1uzU6uYuZY-51">
          <mxCell parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Garamond;" vertex="1">
            <mxGeometry height="26" width="44" x="951" y="364.25" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Self-supervised learning" tooltip="Tận dụng chính dữ liệu tương tác sẵn có để tạo thêm tín hiệu học mà không cần nhãn thủ công. Mô hình có thể tự tạo ra nhiệm vụ đoán item bị che đi hoặc so sánh hai biến thể của cùng một lịch sử người dùng." id="EOgTCbZ0sA1uzU6uYuZY-53">
          <mxCell parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Garamond;" vertex="1">
            <mxGeometry height="26" width="147" x="951" y="242.25" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="RNN / Sequential" tooltip="xử lý dữ liệu theo thứ tự thời gian để dự đoán item kế tiếp hoặc sở thích tiếp theo của user. Ví dụ, người dùng vừa xem điện thoại, rồi xem ốp lưng, rồi xem tai nghe thì mô hình có thể đoán item tiếp theo dựa trên chuỗi hành vi đó." id="EOgTCbZ0sA1uzU6uYuZY-55">
          <mxCell parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Garamond;" vertex="1">
            <mxGeometry height="26" width="111" x="951" y="323.25" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="GNN" tooltip="biểu diễn dữ liệu dưới dạng đồ thị rồi truyền và tổng hợp thông tin từ các node lân cận để học quan hệ bậc cao giữa user, item và entity. Nói đơn giản, nó nhìn vào mạng lưới kết nối để hiểu user giống ai, item liên quan đến item nào, rồi gợi ý dựa trên cấu trúc đó" id="EOgTCbZ0sA1uzU6uYuZY-56">
          <mxCell parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Garamond;" vertex="1">
            <mxGeometry height="26" width="45" x="951" y="405.25" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="EOgTCbZ0sA1uzU6uYuZY-57" edge="1" parent="1" source="EOgTCbZ0sA1uzU6uYuZY-8" style="endArrow=none;html=1;rounded=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;fontFamily=Garamond;" target="EOgTCbZ0sA1uzU6uYuZY-43" value="">
