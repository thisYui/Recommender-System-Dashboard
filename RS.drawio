        <mxCell id="EOgTCbZ0sA1uzU6uYuZY-77" edge="1" parent="1" source="EOgTCbZ0sA1uzU6uYuZY-9" style="endArrow=none;html=1;rounded=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;fontFamily=Garamond;" target="EOgTCbZ0sA1uzU6uYuZY-65" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="889" y="665.25" as="sourcePoint" />
            <mxPoint x="948" y="616.25" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <UserObject label="Context-aware RS" tooltip="Context-aware RS đưa thêm thông tin ngữ cảnh như thời gian, vị trí, thiết bị, tình huống sử dụng hoặc trạng thái hiện tại của người dùng vào quá trình gợi ý. Thay vì chỉ hỏi “user này thích item nào”, mô hình hỏi thêm “user này thích gì trong hoàn cảnh nào”, nên đặc biệt hữu ích cho bài toán như gợi ý nhà hàng theo thời điểm, địa điểm hoặc lịch trình. Thách thức chính là context thường thay đổi nhanh, nhiều chiều, khó thu thập đầy đủ và nếu tích hợp không tốt thì mô hình dễ phức tạp hơn nhưng chưa chắc cải thiện rõ chất lượng gợi ý." id="EOgTCbZ0sA1uzU6uYuZY-79">
          <mxCell parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Garamond;" vertex="1">
            <mxGeometry height="26" width="114" x="519" y="595.25" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Review-based RS" tooltip="khai thác văn bản review và rating để hiểu sâu hơn sở thích người dùng và đặc tính của item. Cách tiếp cận này không chỉ nhìn vào việc user có thích hay không, mà còn cố gắng hiểu vì sao user thích hoặc không thích thông qua nội dung phản hồi, ví dụ như chê chất lượng, khen giá rẻ hoặc thích dịch vụ. Khó khăn lớn là review thường dài, nhiễu, không đồng nhất, có thể chứa spam hoặc ý kiến mâu thuẫn, nên việc trích xuất tín hiệu hữu ích và ổn định từ văn bản không hề đơn giản" id="EOgTCbZ0sA1uzU6uYuZY-80">
          <mxCell parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Garamond;" vertex="1">
            <mxGeometry height="26" width="113" x="520" y="480.25" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Aspect-based RS" tooltip=" tách các khía cạnh cụ thể của item, chẳng hạn giá, pin, màn hình, vị trí, vệ sinh hay thái độ phục vụ. Hệ thống không chỉ biết người dùng thích hay không thích một sản phẩm nói chung, mà còn biết họ thích chính xác khía cạnh nào, từ đó tạo ra recommendation tinh chỉnh hơn theo nhu cầu thực tế. Thách thức nằm ở việc trích xuất đúng aspect, xác định sentiment cho từng aspect trong đúng ngữ cảnh, và xử lý trường hợp cùng một review chứa nhiều ý kiến trái chiều về các thuộc tính khác nhau." id="EOgTCbZ0sA1uzU6uYuZY-81">
          <mxCell parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Garamond;" vertex="1">
            <mxGeometry height="26" width="111" x="522" y="652.25" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Explainable and Trustworthy RS" tooltip="hướng tới việc không chỉ đưa ra gợi ý, mà còn giải thích được lý do và đảm bảo hệ thống vận hành đáng tin cậy. Một hệ tốt trong nhóm này thường cố gắng trả lời những câu như “vì sao mục này được đề xuất”, “dựa trên tín hiệu nào”, và “liệu recommendation có ổn định, an toàn, công bằng và tôn trọng riêng tư hay không”. Điểm khó là giữa accuracy, explainability, fairness, robustness và privacy thường có trade-off, nên càng tăng tính minh bạch và tin cậy thì thiết kế hệ thống càng phức tạp" id="EOgTCbZ0sA1uzU6uYuZY-82">
          <mxCell parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Garamond;" vertex="1">
            <mxGeometry height="26" width="188" x="445" y="537.25" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="FATE / Fairness-aware Rs" tooltip="fairness, accountability, transparency và ethics trong recommendation. Các hệ này cố gắng giảm thiên lệch với nhóm người dùng hoặc nhóm item, kiểm soát cách recommendation được tạo ra, và đảm bảo quyết định của hệ thống không vô tình gây bất lợi cho một nhóm nhất định. Thách thức là fairness không có một định nghĩa duy nhất, thường phải đánh đổi với accuracy hoặc revenue, và rất khó xử lý triệt để nếu dữ liệu gốc đã chứa bias hoặc thiếu thông tin về thuộc tính nhạy cảm." id="EOgTCbZ0sA1uzU6uYuZY-83">
          <mxCell parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Garamond;" vertex="1">
            <mxGeometry height="26" width="156" x="477" y="710.25" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="EOgTCbZ0sA1uzU6uYuZY-84" edge="1" parent="1" source="EOgTCbZ0sA1uzU6uYuZY-10" style="endArrow=none;html=1;rounded=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;fontFamily=Garamond;" target="EOgTCbZ0sA1uzU6uYuZY-80" value="">
