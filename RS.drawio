        <UserObject label="Online&lt;br&gt;Evaluation" tooltip="Online Evaluation đánh giá hệ gợi ý trong môi trường thực tế khi người dùng đang tương tác trực tiếp với hệ thống." id="EOgTCbZ0sA1uzU6uYuZY-102">
          <mxCell parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Garamond;" vertex="1">
            <mxGeometry height="41" width="73" x="115" y="473" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Offine&lt;br&gt;Evaluation" tooltip="đánh giá recommender trên dữ liệu lịch sử mà không cần triển khai trực tiếp cho người dùng thật. Cách này nhanh, rẻ, dễ lặp lại và rất phù hợp để so sánh mô hình ở giai đoạn nghiên cứu, nhưng có hạn chế là kết quả offline không phải lúc nào cũng phản ánh đúng hiệu quả thật khi đưa vào sản phẩm" id="EOgTCbZ0sA1uzU6uYuZY-103">
          <mxCell parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Garamond;" vertex="1">
            <mxGeometry height="41" width="73" x="115" y="557" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Measure" tooltip="nhóm tiêu chí dùng để định lượng chất lượng của recommender system sau khi đánh giá. " id="EOgTCbZ0sA1uzU6uYuZY-104">
          <mxCell parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Garamond;" vertex="1">
            <mxGeometry height="26" width="64" x="254.5" y="616" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="A/B Test" tooltip="là hình thức online evaluation phổ biến, trong đó hai hoặc nhiều phiên bản recommender được chạy song song trên các nhóm người dùng khác nhau để so sánh hiệu quả. Mục tiêu là xem phiên bản nào tạo ra kết quả kinh doanh hoặc trải nghiệm người dùng tốt hơn," id="EOgTCbZ0sA1uzU6uYuZY-106">
          <mxCell parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Garamond;" vertex="1">
            <mxGeometry height="26" width="63" x="11" y="480.25" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="K-Fold Cross&lt;br&gt;Validation" tooltip="là kỹ thuật chia dữ liệu thành nhiều phần, lần lượt dùng một phần để kiểm tra và các phần còn lại để huấn luyện, rồi lấy kết quả trung bình. " id="EOgTCbZ0sA1uzU6uYuZY-107">
          <mxCell parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Garamond;" vertex="1">
            <mxGeometry height="41" width="87" x="-8.5" y="557" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Accuracy" tooltip="phản ánh mức độ hệ thống dự đoán hoặc xếp hạng đúng so với dữ liệu quan sát được. " id="EOgTCbZ0sA1uzU6uYuZY-108">
          <mxCell parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Garamond;" vertex="1">
            <mxGeometry height="26" width="67" x="169.5" y="695" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Diversity" tooltip="phản ánh mức độ đa dạng giữa các item trong danh sách gợi ý, tức là recommendation không quá giống nhau. " id="EOgTCbZ0sA1uzU6uYuZY-109">
          <mxCell parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Garamond;" vertex="1">
            <mxGeometry height="26" width="64" x="332" y="695" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Coverage" tooltip="đo mức độ hệ thống có thể gợi ý được cho bao nhiêu user hoặc bao nhiêu item trong toàn bộ không gian dữ liệu." id="EOgTCbZ0sA1uzU6uYuZY-110">
          <mxCell parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Garamond;" vertex="1">
            <mxGeometry height="26" width="69" x="167.5" y="742.75" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Robustness" tooltip="thể hiện khả năng recommender vẫn hoạt động ổn định khi dữ liệu nhiễu, thiếu, bị thao túng hoặc thay đổi bất thường. Chỉ số này ngày càng quan trọng vì hệ thực tế thường phải đối mặt với spam, feedback lệch, dữ liệu không hoàn hảo và môi trường thay đổi liên tục." id="EOgTCbZ0sA1uzU6uYuZY-111">
          <mxCell parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Garamond;" vertex="1">
            <mxGeometry height="26" width="81" x="332" y="742.75" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Novelty" tooltip="đo xem hệ thống có gợi ý những item mới hoặc ít hiển nhiên đối với người dùng hay không. Đây là yếu tố quan trọng để giúp user khám phá nội dung mới, dù việc tăng novelty thường phải cân bằng với accuracy và mức độ quen thuộc." id="EOgTCbZ0sA1uzU6uYuZY-112">
          <mxCell parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Garamond;" vertex="1">
            <mxGeometry height="26" width="58" x="178.5" y="789.75" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Stability" tooltip="đo mức độ kết quả recommendation có giữ được tính nhất quán khi dữ liệu hoặc quá trình huấn luyện thay đổi nhẹ. Một hệ quá thiếu stability có thể cho ra gợi ý dao động mạnh giữa các lần chạy, làm giảm độ tin cậy trong vận hành thực tế." id="EOgTCbZ0sA1uzU6uYuZY-113">
          <mxCell parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Garamond;" vertex="1">
            <mxGeometry height="26" width="60" x="332" y="789.75" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Serendipity" tooltip="nói đến khả năng gợi ý những item vừa bất ngờ vừa hữu ích, tức là không chỉ mới mà còn đúng nhu cầu. Đây là một mục tiêu khó vì recommendation phải tránh cả hai cực: quá quen thuộc thì không thú vị, quá xa sở thích thì không còn hữu ích." id="EOgTCbZ0sA1uzU6uYuZY-114">
          <mxCell parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Garamond;" vertex="1">
            <mxGeometry height="26" width="78" x="158.5" y="837.75" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Scalability" tooltip="phản ánh khả năng hệ thống duy trì hiệu năng khi số user, số item và khối lượng tương tác tăng lên." id="EOgTCbZ0sA1uzU6uYuZY-115">
          <mxCell parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Garamond;" vertex="1">
            <mxGeometry height="26" width="72" x="332" y="837.75" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Rating&lt;br&gt;Prediction" tooltip="là dạng đánh giá xem mô hình dự đoán điểm số hoặc mức độ yêu thích của người dùng với item chính xác đến đâu. " id="EOgTCbZ0sA1uzU6uYuZY-116">
          <mxCell parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Garamond;" vertex="1">
            <mxGeometry height="41" width="71" x="74" y="658" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Item&lt;br&gt;Ranking" tooltip="đánh giá khả năng sắp xếp item đúng thứ tự ưu tiên để các item phù hợp nhất xuất hiện ở vị trí cao" id="EOgTCbZ0sA1uzU6uYuZY-117">
          <mxCell parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Garamond;" vertex="1">
            <mxGeometry height="41" width="62" x="74" y="749.5" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="EOgTCbZ0sA1uzU6uYuZY-119" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Garamond;" value="MAE" vertex="1">
          <mxGeometry height="26" width="44" x="7" y="680" as="geometry" />
        </mxCell>
        <UserObject label="MAP" tooltip="đo chất lượng ranking bằng cách xem các item liên quan xuất hiện sớm và đều trong danh sách gợi ý đến mức nào. Chỉ số này phù hợp khi quan tâm đến toàn bộ thứ tự của nhiều item đúng" id="EOgTCbZ0sA1uzU6uYuZY-120">
          <mxCell parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Garamond;" vertex="1">
            <mxGeometry height="26" width="44" x="7" y="719" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="NDCG" tooltip="đo chất lượng ranking bằng cách thưởng cao hơn cho các item phù hợp xuất hiện ở vị trí đầu danh sách." id="EOgTCbZ0sA1uzU6uYuZY-121">
          <mxCell parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Garamond;" vertex="1">
            <mxGeometry height="26" width="53" x="-2" y="757" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="MRR" tooltip="tập trung vào vị trí của item đúng đầu tiên trong danh sách recommendation. Chỉ số này hữu ích khi chỉ cần biết hệ thống có đưa ra một gợi ý tốt rất sớm hay không, nhưng nó không phản ánh đầy đủ chất lượng của cả danh sách dài hơn." id="EOgTCbZ0sA1uzU6uYuZY-122">
          <mxCell parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Garamond;" vertex="1">
            <mxGeometry height="26" width="45" x="6" y="795" as="geometry" />
          </mxCell>
        </UserObject>
