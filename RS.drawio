          </mxCell>
        </UserObject>
        <UserObject label="Model-based" tooltip="Học một mô hình ẩn từ ma trận tương tác để rút ra latent factors của user và item. Cách này thường mạnh hơn memory-based về khả năng khái quát hóa, nhưng phức tạp hơn và khó giải thích hơn." id="EOgTCbZ0sA1uzU6uYuZY-25">
          <mxCell parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Garamond;" vertex="1">
