        <UserObject label="User-based" tooltip="Dự đoán user sẽ thích item nào bằng cách tìm các user có lịch sử sở thích giống họ. Ý tưởng cốt lõi là “người giống bạn thường thích những thứ tương tự bạn”." id="EOgTCbZ0sA1uzU6uYuZY-27">
          <mxCell parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Garamond;" vertex="1">
            <mxGeometry height="26" width="79" x="1300" y="34" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Item-based" tooltip="Dự đoán bằng cách tìm các item giống với những item user đã thích trước đó. Cách này thường ổn định hơn user-based khi số user thay đổi lớn." id="EOgTCbZ0sA1uzU6uYuZY-28">
          <mxCell parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Garamond;" vertex="1">
